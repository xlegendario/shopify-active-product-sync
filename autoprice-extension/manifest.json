{
  "manifest_version": 3,
  "name": "Lojiq Autopricing - StockX Pro",
  "version": "1.1.0",
  "description": "Reads StockX Pro and GOAT prices for all sizes of a product, for autopricing. Reads only; never bids or buys.",
  "permissions": ["tabs", "scripting", "alarms", "storage"],
  "host_permissions": [
    "https://shopify-active-product-sync.onrender.com/*",
    "https://pro.stockx.com/*",
    "https://accounts.stockx.com/*",
    "https://stockx.com/*",
    "https://www.goat.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html" }
}
